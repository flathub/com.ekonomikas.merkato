{
  "app-id": "com.ekonomikas.merkato",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "merkato",
  "build-options": {
    "strip": true,
    "no-debuginfo": true
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "/share/vala",
    "*.la",
    "*.a",
    "/lib/python3.*/site-packages/**/tests",
    "/lib/python3.*/site-packages/**/test",
    "/lib/python3.*/site-packages/**/examples"
  ],
  "modules": [
    {
      "name": "com.ekonomikas.merkato",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": ["--libdir=lib"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/sheep-farm/merkato.git",
          "commit": "72588618c9f2ce22176ec0556ba1d78adafc2ff9"
        }
      ]
    }
  ]
}
