{
  "app-id": "com.ekonomikas.merkato",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "merkato",
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "strip": true,
    "no-debuginfo": true,
    "env": {
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "/share/vala",
    "*.la",
    "*.a",
    "/lib/python3.12/site-packages/**/tests",
    "/lib/python3.12/site-packages/**/test",
    "/lib/python3.12/site-packages/**/__pycache__",
    "/lib/python3.12/site-packages/**/examples",
    "*.pyc"
  ],
  "modules": [
    {
      "name": "com.ekonomikas.merkato",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": ["--libdir=lib"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/sheep-farm/merkato.git",
          "tag": "v0.3.0",
          "commit": "ca03cb386669d92942557ea526114826413d8267"
        },
        "cargo-sources.json",
        {
          "type": "shell",
          "commands": [
            "mkdir -p .cargo",
            "cp -vf cargo/config .cargo/config.toml"
          ]
        }
      ]
    }
  ]
}
